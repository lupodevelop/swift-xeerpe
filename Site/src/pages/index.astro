---
import { readFileSync, readdirSync } from "node:fs";
import { resolve } from "node:path";
import Base from "../layouts/Base.astro";
import iphone from "@tabler/icons/outline/device-mobile.svg?raw";
import mac from "@tabler/icons/outline/device-laptop.svg?raw";
import tv from "@tabler/icons/outline/device-tv.svg?raw";
import vision from "@tabler/icons/outline/device-vision-pro.svg?raw";
import watch from "@tabler/icons/outline/device-watch.svg?raw";
import Scrub from "../components/Scrub.astro";
import { chapters } from "../data/scenes";
import { textFill, metalFill, surface } from "../data/fill";
import "xeerpe/animations.css";

const repo = import.meta.env.PUBLIC_REPO_URL as string | undefined;
// Every effect family, by what it does. The names are checked against the
// Swift API below, so a renamed or removed effect fails the build.
const families: [string, string[]][] = [
  ["Basics", ["blur", "opacity", "scale", "gradient", "fill", "pulse", "breathe", "shimmer", "backdrop", "surface", "preset"]],
  ["Light", ["glow", "bloom", "aura", "edgeGlow", "spotlight", "borderBeam", "halation", "lightLeak", "glare"]],
  ["Metals and finishes", ["chrome", "foil", "holo", "pearl", "brushed", "guilloche", "bevel", "emboss", "sparkle"]],
  ["Film and print", ["grade", "grain", "gradientMap", "duo", "vignette", "halftone", "dither", "riso", "colorBleed", "toon"]],
  ["Old screens", ["scanlines", "phosphor", "barrel", "flicker", "tracking", "glitch", "pixelate", "ascii", "matrix"]],
  ["Reveal and hide", ["reveal", "hoverReveal", "inkReveal", "torch", "focusReveal", "spoiler", "scratch", "blurSweep", "privacy"]],
  ["Liquid and particles", ["liquid", "ripple", "lens", "gooey", "smoke", "sparks", "burn", "embers", "genie", "starfield", "dotField"]],
  ["Depth and touch", ["tilt3D", "card", "viewAngle", "glass", "transfer", "transferSource", "transferTarget", "feedback", "loading"]],
];
// npm scripts run in Site/, so the Swift sources are one level up.
const sources = resolve(process.cwd(), "../Sources/xeerpe");
const swift = (path: string) => readFileSync(resolve(sources, path), "utf8");
// Every name a chain can call: the generated API has an instance form for each.
const chainNames = new Set([...swift("Generated/API.swift").matchAll(/public (?:static )?func (\w+)/g)].map((m) => m[1]));
const missing = families.flatMap(([, names]) => names).filter((n) => !chainNames.has(n));
if (missing.length) throw new Error(`Effects not in the Swift API: ${missing.join(", ")}`);
// The other way round too: a new effect has to be listed here. Presets and
// the job phase builder are not effects.
const presetNames = new Set([...swift("Styles/Presets.swift").matchAll(/public static func (\w+)/g)].map((m) => m[1]));
const listed = new Set(families.flatMap(([, names]) => names));
const unlisted = [...chainNames].filter((n) => !listed.has(n) && !presetNames.has(n) && n !== "phases");
if (unlisted.length) throw new Error(`Effects missing from the site: ${unlisted.join(", ")}`);
const presetCount = presetNames.size;
const catalogCount = readdirSync(resolve(sources, "Catalog/Generated"))
  .map((f) => swift(`Catalog/Generated/${f}`).match(/XeerpePreset\("/g)?.length ?? 0)
  .reduce((a, b) => a + b, 0);
const effectCount = listed.size;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const chain = [
  ["A preset", "view.xeerpe(.aurora())"],
  ["Your own chain", "view.xeerpe { .liquid(.ocean, speed: 0.6).lens(radius: 70) }"],
  ["A preset, edited", "XeerpeChain.pond().without(.distortion).adding { .lens(radius: 80) }"],
];
const signals = ["tilt", "touch", "drag", "hover", "press", "beat", "job progress", "your bindings"];
const ecosystem = [
  {
    logo: "logos/xeerpe-swift.png",
    lang: "Swift",
    name: "xeerpe for SwiftUI",
    copy: "Metal shaders, reactive to tilt, touch and time. Native on every Apple platform.",
    install: "File › Add Package Dependencies",
    code: `view.xeerpe { .preset(.gold, reacting: .tilt) }`,
    links: [] as [string, string][],
  },
  {
    logo: "logos/xeerpe.png",
    lang: "TypeScript",
    name: "xeerpe",
    copy: "CSS backgrounds and gradient text as one chain. Any framework, zero dependencies. By Nicola Centonze.",
    install: "npm install xeerpe",
    code: `new Preset("gold").grain({ intensity: 1.5 }).toStyle()`,
    links: [["xeerpe.io", "https://xeerpe.io"], ["npm", "https://www.npmjs.com/package/xeerpe"]] as [string, string][],
  },
  {
    logo: "logos/xeerpe-gleam.png",
    lang: "Gleam",
    name: "xeerpe for Gleam",
    copy: "A typed binding for the JavaScript target, with xeerpe bundled. Unknown presets are an Error, not an exception.",
    install: "gleam add xeerpe",
    code: `let assert Ok(gold) = xeerpe.preset("gold")
gold |> xeerpe.grain(xeerpe.grain_options) |> xeerpe.to_style`,
    links: [["Hex", "https://hex.pm/packages/xeerpe"], ["Docs", "https://xeerpe.hexdocs.pm/"]] as [string, string][],
  },
];
// Each device lights its screen with a preset of the xeerpe npm library on
// hover. The screen is the icon's longest outline, used as a clip path.
const screenOf = (svg: string) =>
  [...svg.matchAll(/ d="([^"]+)"/g)].map((m) => m[1]).filter((d) => !d.startsWith("M0 0h24")).sort((a, b) => b.length - a.length)[0];
const platforms = [
  { device: "iPhone and iPad", os: "iOS 17", icon: iphone, preset: "aurora-dream" },
  { device: "Mac", os: "macOS 14", icon: mac, preset: "ocean-drift" },
  { device: "Apple TV", os: "tvOS 17", icon: tv, preset: "northern-lights" },
  { device: "Apple Vision Pro", os: "visionOS 26", icon: vision, preset: "breathing-nebula" },
  { device: "Apple Watch", os: "watchOS 10", icon: watch, preset: "molten-gold" },
].map((p) => ({ ...p, screen: `${surface(p.preset)}; clip-path: path('${screenOf(p.icon)}')` }));
---
<Base title="xeerpe" description="Chainable effects for SwiftUI, drawn by Metal. Surfaces, reveals and cards that answer to touch, tilt and time.">

  <Scrub length={240}>
    <h1 class="word" style={metalFill}>xeerpe</h1>
    <div class="hero-copy">
      <p class="kicker" data-at="0">Scroll</p>
      <p class="subtitle" data-at="0.3">Chainable effects for SwiftUI.</p>
      <p class="subtitle" data-at="0.75">Drawn by Metal.<br /><span class="muted">Moved by the device in your hand.</span></p>
    </div>
  </Scrub>

  <section class="block start" id="start">
    <h2 class="display" style={textFill("iridescent")}>Start.</h2>
    <div class="start-grid">
      <div>
        <p class="subtitle">Add the package in Xcode, then import it.</p>
        <p class="muted">File › Add Package Dependencies.</p>
      </div>
      <div class="start-code">
        {repo && <pre class="code">{`.package(url: "${repo}", branch: "main")`}</pre>}
        <pre class="code">{`import xeerpe

card.xeerpe(.card(.holographic, .tilt))`}</pre>
      </div>
    </div>
    <ul class="platforms" aria-label="Platforms">
      {platforms.map((p) => (
        <li>
          <span class="platform-icon" aria-hidden="true">
            <span class="platform-screen" style={p.screen} />
            <Fragment set:html={p.icon} />
          </span>
          <span class="platform-device">{p.device}</span>
          <span class="platform-os">{p.os} and later</span>
        </li>
      ))}
    </ul>
  </section>

  {chapters.map((c, i) => (
    <Scrub scene={c.scene} label={c.title}>
      <header class="chapter-top" slot="top">
        <p class="kicker">{String(i + 1).padStart(2, "0")}</p>
        <h2 class="title">{c.title}</h2>
      </header>
      <div class="chapter-bottom" slot="bottom">
        <div class="notes">
          {c.captions.map((n) => <p class="subtitle note" data-at={n.at}>{n.text}</p>)}
        </div>
        <pre class="code">{c.code}</pre>
      </div>
    </Scrub>
  ))}

  <section class="block more">
    <p class="kicker">And more</p>
    <h2 class="title">{effectCount} effects. {presetCount} presets.<br /><span class="muted">{catalogCount} catalog surfaces.</span></h2>
    <p class="subtitle muted lead">The scenes above are a few of them. Every effect chains with the others and reads the same signals.</p>
    <div class="families">
      {families.map(([name, names]) => (
        <div>
          <p class="kicker">{name}</p>
          <ul>{names.map((n) => <li>.{n}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="block chain">
    <p class="kicker">Composition</p>
    <h2 class="title">Effects are links.<br /><span class="muted">Presets are chains.</span></h2>
    <ol>
      {chain.map(([label, code], i) => (
        <li>
          <span class="kicker">{String(i + 1).padStart(2, "0")} · {label}</span>
          <pre class="code">{code}</pre>
        </li>
      ))}
    </ol>
  </section>

  <section class="block signals">
    <h2 class="title">Everything moves<br />on a signal.</h2>
    <p class="subtitle muted lead">Sensors, gestures and async work arrive as values. Any effect can read them, remap them and combine them.</p>
    <ul>{signals.map((s) => <li>{s}</li>)}</ul>
  </section>

  <section class="block eco">
    <p class="kicker">Ecosystem</p>
    <h2 class="title"><span style={textFill("aurora-dream")}>One philosophy.</span><br />Three APIs.</h2>
    <p class="subtitle muted lead">Effects as chains, presets you can take apart. Each package speaks its own platform's language.</p>
    <div class="eco-grid">
      {ecosystem.map((e) => (
        <article>
          <img class="eco-logo" src={base + e.logo} alt="" width="64" height="64" />
          <p class="kicker">{e.lang}</p>
          <h3 class="subtitle">{e.name}</h3>
          <p class="muted">{e.copy}</p>
          <pre class="code">{e.install}</pre>
          <pre class="code">{e.code}</pre>
          {e.links.map(([label, href]) => <a class="eco-link" href={href}>{label} ↗</a>)}
        </article>
      ))}
    </div>
  </section>

</Base>

<style>
  /* Scroll keyframes: the word arrives from wide, blurred and dark, settles
     in the first 40% of the scene, then a band of light crosses it. */
  .word {
    --settle: min(1, calc(var(--p) * 2.5));
    --sweep: clamp(0, calc((var(--p) - 0.25) / 0.7), 1);
    position: absolute;
    top: 46%;
    left: 50%;
    width: max-content;
    margin: 0;
    /* background-clip: text paints only inside the box: the padding keeps the
       descender of the p and the last letter, pulled out by the negative
       tracking, inside it. */
    padding: 0.08em 0.16em 0.24em 0.1em;
    font-family: "Nunito", var(--display);
    font-size: clamp(88px, 21vw, 380px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: calc(0.14em - var(--settle) * 0.19em);
    background-position: calc(100% - var(--sweep) * 100%) 50%;
    filter: blur(calc(16px - var(--settle) * 16px)) brightness(calc(0.45 + var(--settle) * 0.55));
    transform: translate(-50%, -50%) scale(calc(1.3 - var(--settle) * 0.3));
    will-change: transform, filter, background-position;
  }
  .hero-copy { position: absolute; inset: 0; padding: 96px var(--gutter) 64px; display: grid; align-content: end; }
  .hero-copy > * { grid-area: 1 / 1; margin: 0; max-width: 18ch; }

  .chapter-top { display: flex; align-items: baseline; gap: 20px; }
  .chapter-top .kicker { margin: 0; }
  .chapter-top .title { font-size: clamp(32px, 5vw, 72px); }
  .chapter-bottom { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: end; }
  .notes { display: grid; }
  .note { grid-area: 1 / 1; margin: 0; max-width: 28ch; font-size: clamp(18px, 2vw, 26px); }
  .chapter-bottom .code { max-width: min(52vw, 640px); }
  @media (max-width: 760px) {
    .chapter-top { flex-direction: column; gap: 6px; }
    .chapter-bottom { grid-template-columns: minmax(0, 1fr); }
    .chapter-bottom .code { max-width: 100%; font-size: 12px; }
  }

  .chain ol { list-style: none; margin: 72px 0 0; padding: 0; display: grid; gap: 28px; max-width: 900px; }
  .chain li { display: grid; gap: 10px; }
  .chain li:nth-child(2) { margin-left: clamp(0px, 6vw, 80px); }
  .chain li:nth-child(3) { margin-left: clamp(0px, 12vw, 160px); }
  .chain .title { margin-top: 16px; }

  .signals { border-top: 1px solid var(--line); }
  .lead { max-width: 30ch; margin: 28px 0 0; }
  .signals ul { list-style: none; margin: 56px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .signals li {
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font: 15px var(--mono);
  }

  .eco { border-top: 1px solid var(--line); }
  .eco-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; margin-top: 64px; }
  .eco article { display: grid; gap: 14px; align-content: start; padding: 28px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); }
  .eco article .kicker, .eco article p { margin: 0; }
  .eco .code { font-size: 12.5px; }
  .eco-logo { width: 64px; height: 64px; border-radius: 16px; }
  .eco-link { justify-self: start; font: 500 13px var(--mono); color: var(--accent); text-decoration: none; }
  .eco-link:hover { text-decoration: underline; }

  .start { border-top: 1px solid var(--line); }
  .start-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 48px; margin-top: 56px; }
  .start-code { display: grid; gap: 14px; align-content: start; }
  .families { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 32px 24px; margin-top: 40px; }
  .families ul { list-style: none; padding: 0; margin: 12px 0 0; font: 14px/1.9 var(--mono); color: var(--text); }
  /* The platforms as a row of devices, like a product page: a large thin
     outline, the device, then the system it needs. */
  .platforms { list-style: none; padding: 48px 0 0; margin: 72px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 40px 16px; text-align: center; }
  .platforms li { display: grid; justify-items: center; gap: 6px; }
  .platform-icon { display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: 12px; color: var(--text); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  .platform-icon :global(svg) { width: 56px; height: 56px; stroke-width: 1.1; position: relative; }
  /* The screen is drawn in the icon's 24-unit space and scaled to its 56px,
     under the outline, so the stroke covers its edge. */
  .platform-icon { position: relative; }
  .platform-screen { position: absolute; left: 4px; top: 4px; width: 24px; height: 24px; transform: scale(calc(56 / 24)); transform-origin: 0 0; opacity: 0; animation-play-state: paused !important; transition: opacity 0.6s ease; }
  .platforms li:hover .platform-screen { opacity: 1; animation-play-state: running !important; }
  .platforms li:hover .platform-icon { transform: translateY(-3px); }
  .platform-device { font: 500 17px/1.3 var(--sans); color: var(--text); }
  .platform-os { font: 14px/1.4 var(--sans); color: var(--muted); }
  @media (max-width: 760px) { .platforms { grid-template-columns: repeat(2, minmax(0, 1fr)); } .platforms li:last-child { grid-column: 1 / -1; } }
  @media (prefers-reduced-motion: reduce) { .platform-icon { transition: none; } .platforms li:hover .platform-icon { transform: none; } .platform-screen, .platforms li:hover .platform-screen { animation: none !important; } }
  @media (max-width: 760px) { .start-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
